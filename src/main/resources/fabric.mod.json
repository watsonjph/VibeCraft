{
	"schemaVersion": 1,
	"id": "vibecraft",
	"version": "${version}",
	"name": "VibeCraft",
	"description": "An agent IDE inside Minecraft: your coding agents are NPCs that plan, code in git worktrees, and ask you before anything is merged.",
	"authors": [
		"watsonjph"
	],
	"license": "GPL-3.0-only",
	"environment": "*",
	"entrypoints": {
		"main": [
			"io.github.watsonjph.vibecraft.VibeCraft"
		],
		"client": [
			"io.github.watsonjph.vibecraft.client.VibeCraftClient"
		]
	},
	"depends": {
		"fabricloader": ">=0.20.1",
		"minecraft": "~26.3",
		"java": ">=25",
		"fabric-api": "*"
	}
}
